{
  "name": "@abi-software/plotvuer",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ABI-Software/plotvuer.git"
  },
  "scripts": {
    "serve": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "build-bundle": "vite build",
    "start": "vite --host --port 8081",
    "version": "npm run build-bundle",
    "release:beta": "npm version prerelease --preid=beta; npm publish --tag beta",
    "release:minor": "npm version minor; npm publish",
    "release:patch": "npm version patch;  npm publish",
    "vuese-gen": "node vuese-generator.js",
    "vuese-watch": "node vuese-generator.js watch",
    "docs:dev": "vitepress dev docs",
    "docs:watch": "concurrently \"npm run vuese-watch\" \"npm run docs:dev\"",
    "docs:build": "npm run vuese-gen; vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "type": "module",
  "main": "./dist/plotvuer.umd.cjs",
  "module": "./dist/plotvuer.js",
  "exports": {
    ".": {
      "import": "./dist/plotvuer.js",
      "require": "./dist/plotvuer.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./src/*": "./src/*"
  },
  "files": [
    "dist/*",
    "src/*",
    "public/*",
    "*.json",
    "*.js"
  ],
  "dependencies": {
    "@abi-software/svg-sprite": "1.1.0",
    "css-element-queries": "^1.2.3",
    "element-plus": "^2.14.5",
    "papaparse": "^5.7.0",
    "plotly.js": "2.35.3",
    "vue": "^3.5.41",
    "vue-draggable-resizable": "^2.3.0",
    "vue-router": "^5.2.0",
    "vue3-draggable-resizable": "^1.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vuese/markdown-render": "^2.11.3",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitepress": "^1.6.4",
    "vue-docgen-api": "^4.79.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.4",
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
